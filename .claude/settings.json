{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run check:*)",
      "Bash(npm run build:*)",
      "Bash(npm run format:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)"
    ],
    "deny": [
      "Read(./_archive/**)",
      "Glob(./_archive/**)",
      "Grep(./_archive/**)",
      "Read(./dados-reais/**)"
    ]
  }
}
